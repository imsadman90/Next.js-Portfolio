# Copy this file to ".env" and fill in real values. NEVER commit ".env".
# Used only server-side by the contact API route (app/api/contact/route.js).

# Gmail address that sends/receives contact-form messages
EMAIL_USER=your-address@gmail.com

# Gmail APP PASSWORD (NOT your account password).
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_PASS=your-16-char-app-password
